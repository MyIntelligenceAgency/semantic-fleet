# OpenAI API
# Clé API OpenAI pour accéder aux modèles OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter API
# Clé API OpenRouter pour accéder à divers modèles open-source et commerciaux
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modèles spécifiques via OpenRouter
# Claude 3 Sonnet 3.7
CLAUDE_SONNET_API_KEY=${OPENROUTER_API_KEY}
CLAUDE_SONNET_BASE_URL=${OPENROUTER_BASE_URL}
CLAUDE_SONNET_MODEL_ID=anthropic/claude-3-sonnet-20240229

# Gemini Pro 2.5
GEMINI_PRO_API_KEY=${OPENROUTER_API_KEY}
GEMINI_PRO_BASE_URL=${OPENROUTER_BASE_URL}
GEMINI_PRO_MODEL_ID=google/gemini-pro-1.5

# Qwen 3 (plusieurs variantes)
# Qwen 3 1.7B
QWEN_1_7B_API_KEY=${OPENROUTER_API_KEY}
QWEN_1_7B_BASE_URL=${OPENROUTER_BASE_URL}
QWEN_1_7B_MODEL_ID=qwen/qwen3-1.7b

# Qwen 3 8B
QWEN_8B_API_KEY=${OPENROUTER_API_KEY}
QWEN_8B_BASE_URL=${OPENROUTER_BASE_URL}
QWEN_8B_MODEL_ID=qwen/qwen3-8b

# Qwen 3 14B
QWEN_14B_API_KEY=${OPENROUTER_API_KEY}
QWEN_14B_BASE_URL=${OPENROUTER_BASE_URL}
QWEN_14B_MODEL_ID=qwen/qwen3-14b

# Qwen 3 30B A3B
QWEN_30B_A3B_API_KEY=${OPENROUTER_API_KEY}
QWEN_30B_A3B_BASE_URL=${OPENROUTER_BASE_URL}
QWEN_30B_A3B_MODEL_ID=qwen/qwen3-30b-a3b

# Qwen 3 32B
QWEN_32B_API_KEY=${OPENROUTER_API_KEY}
QWEN_32B_BASE_URL=${OPENROUTER_BASE_URL}
QWEN_32B_MODEL_ID=qwen/qwen3-32b

# Local Model - Micro
LOCAL_MICRO_API_KEY=YOUR_LOCAL_MICRO_API_KEY
LOCAL_MICRO_BASE_URL=https://api.micro.text-generation-webui.myia.io/v1
LOCAL_MICRO_MODEL_ID=micro

# Local Model - Mini
LOCAL_MINI_API_KEY=YOUR_LOCAL_MINI_API_KEY
LOCAL_MINI_BASE_URL=https://api.mini.text-generation-webui.myia.io/v1
LOCAL_MINI_MODEL_ID=mini

# Local Model - Medium
LOCAL_MEDIUM_API_KEY=YOUR_LOCAL_MEDIUM_API_KEY
LOCAL_MEDIUM_BASE_URL=https://api.medium.text-generation-webui.myia.io/v1
LOCAL_MEDIUM_MODEL_ID=medium

# Stable Diffusion URLs
SD_BASE_URL=YOUR_SD_BASE_URL
SD_BASE_URL_2=YOUR_SD_BASE_URL_2